rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isMember(messId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/messes/$(messId)/members/$(request.auth.uid));
    }

    function myRole(messId) {
      return get(/databases/$(database)/documents/messes/$(messId)/members/$(request.auth.uid)).data.role;
    }

    function isAdmin(messId) {
      return isMember(messId) &&
        (myRole(messId) == 'admin' || myRole(messId) == 'super_admin');
    }

    function isSuperAdmin(messId) {
      return isMember(messId) && myRole(messId) == 'super_admin';
    }

    function myUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasMess() {
      return signedIn() &&
        myUser().messId is string &&
        myUser().messId.size() > 0;
    }

    function sameMessAs(uid) {
      return hasMess() &&
        exists(/databases/$(database)/documents/messes/$(myUser().messId)/members/$(uid));
    }

    function friendshipId(a, b) {
      return a < b ? a + '_' + b : b + '_' + a;
    }

    function areFriends(a, b) {
      return exists(/databases/$(database)/documents/friendships/$(friendshipId(a, b)));
    }

    function isMonthLocked(messId, yearMonth) {
      return yearMonth is string &&
        yearMonth.size() >= 7 &&
        exists(/databases/$(database)/documents/messes/$(messId)/month_locks/$(yearMonth)) &&
        get(/databases/$(database)/documents/messes/$(messId)/month_locks/$(yearMonth)).data.locked == true;
    }

    function dayYearMonth(day) {
      return day is string && day.size() >= 7 ? day.substring(0, 7) : '';
    }

    function messCreatedBy(messId) {
      return get(/databases/$(database)/documents/messes/$(messId)).data.createdBy;
    }

    // ---- Users ----
    match /users/{userId} {
      // Get by id (profile/friends) OK; list-all blocked to stop data scraping.
      allow get: if signedIn();
      allow list: if false;

      allow create: if signedIn() &&
        request.auth.uid == userId &&
        (!('role' in request.resource.data));

      allow delete: if signedIn() && request.auth.uid == userId;

      allow update: if signedIn() && (
        (
          request.auth.uid == userId &&
          (
            !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['messId', 'messName']) ||
            request.resource.data.messId == null ||
            (
              request.resource.data.messId is string &&
              exists(/databases/$(database)/documents/messes/$(request.resource.data.messId)/members/$(request.auth.uid))
            )
          )
        ) ||
        (
          resource.data.messId is string &&
          isAdmin(resource.data.messId) &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['messId', 'messName']) &&
          request.resource.data.messId == null
        )
      );

      match /notifications/{notifId} {
        allow read, update, delete: if signedIn() && request.auth.uid == userId;
        // Only self or same-mess members can create inbox items (blocks spam floods).
        allow create: if signedIn() && (
          request.auth.uid == userId ||
          sameMessAs(userId)
        );
      }
    }

    // ---- Messes ----
    match /messes/{messId} {
      // Join needs get before membership; list-all blocked.
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.code is string &&
        request.resource.data.code.size() == 6;
      allow update, delete: if isAdmin(messId);

      match /members/{memberId} {
        allow read: if isMember(messId);

        // Self join as member OR creator as super_admin OR admin invites member.
        allow create: if signedIn() && (
          (
            request.auth.uid == memberId &&
            request.resource.data.role == 'member'
          ) ||
          (
            request.auth.uid == memberId &&
            request.resource.data.role == 'super_admin' &&
            messCreatedBy(messId) == request.auth.uid
          ) ||
          (
            isAdmin(messId) &&
            request.auth.uid != memberId &&
            request.resource.data.role == 'member'
          )
        );

        allow delete: if signedIn() && (
          request.auth.uid == memberId ||
          (isSuperAdmin(messId) && resource.data.role != 'super_admin') ||
          (isAdmin(messId) && !isSuperAdmin(messId) && resource.data.role == 'member')
        );

        // Cannot self-escalate role; only super_admin changes roles.
        allow update: if signedIn() && (
          (
            request.auth.uid == memberId &&
            request.resource.data.role == resource.data.role
          ) ||
          (
            isSuperAdmin(messId) &&
            resource.data.role != 'super_admin' &&
            request.resource.data.role in ['admin', 'member']
          ) ||
          (
            isAdmin(messId) &&
            !isSuperAdmin(messId) &&
            resource.data.role == 'member' &&
            request.resource.data.role == 'member'
          )
        );
      }

      match /meals/{day} {
        allow read: if isMember(messId);
        allow write: if isAdmin(messId) && !isMonthLocked(messId, dayYearMonth(day));

        match /items/{itemId} {
          allow read: if isMember(messId);
          allow create: if isMember(messId) &&
            !isMonthLocked(messId, dayYearMonth(day)) && (
            (isAdmin(messId) &&
              request.resource.data.status in ['approved', 'pending']) ||
            (!isAdmin(messId) &&
              request.resource.data.uid == request.auth.uid &&
              request.resource.data.status == 'pending')
          );
          allow update: if isMember(messId) &&
            !isMonthLocked(messId, dayYearMonth(day)) && (
            isAdmin(messId) ||
            (
              resource.data.uid == request.auth.uid &&
              resource.data.status == 'pending' &&
              request.resource.data.uid == resource.data.uid &&
              request.resource.data.status == 'pending'
            )
          );
          allow delete: if isMember(messId) &&
            !isMonthLocked(messId, dayYearMonth(day)) && (
            isAdmin(messId) ||
            (resource.data.uid == request.auth.uid &&
              resource.data.status == 'pending')
          );
        }

        match /entries/{uid} {
          allow read: if isMember(messId);
          allow write: if isAdmin(messId) && !isMonthLocked(messId, dayYearMonth(day));
        }
      }

      match /markets/{marketId} {
        allow read: if isMember(messId);
        allow create: if isMember(messId) &&
          !isMonthLocked(messId, request.resource.data.yearMonth) && (
          (isAdmin(messId) &&
            request.resource.data.status in ['approved', 'pending']) ||
          (!isAdmin(messId) &&
            request.resource.data.shopperUid == request.auth.uid &&
            request.resource.data.status == 'pending')
        );
        allow update: if isMember(messId) &&
          !isMonthLocked(messId, resource.data.yearMonth) && (
          isAdmin(messId) ||
          (
            resource.data.shopperUid == request.auth.uid &&
            resource.data.status == 'pending' &&
            request.resource.data.shopperUid == resource.data.shopperUid &&
            request.resource.data.status == 'pending'
          )
        );
        allow delete: if isMember(messId) &&
          !isMonthLocked(messId, resource.data.yearMonth) && (
          isAdmin(messId) ||
          (resource.data.shopperUid == request.auth.uid &&
            resource.data.status == 'pending')
        );
      }

      match /bazaar_schedules/{scheduleId} {
        allow read: if isMember(messId);
        allow create: if isMember(messId) && (
          (isAdmin(messId) &&
            request.resource.data.status in ['approved', 'pending']) ||
          (!isAdmin(messId) &&
            request.resource.data.uid == request.auth.uid &&
            request.resource.data.status == 'pending')
        );
        allow update: if isMember(messId) && (
          isAdmin(messId) ||
          (
            resource.data.uid == request.auth.uid &&
            resource.data.status == 'pending' &&
            request.resource.data.uid == resource.data.uid &&
            request.resource.data.status == 'pending'
          )
        );
        allow delete: if isMember(messId) && (
          isAdmin(messId) ||
          (resource.data.uid == request.auth.uid &&
            resource.data.status == 'pending')
        );
      }

      match /bills/{billId} {
        allow read: if isMember(messId);
        allow create: if isAdmin(messId) &&
          !isMonthLocked(messId, request.resource.data.yearMonth);
        allow update, delete: if isAdmin(messId) &&
          !isMonthLocked(messId, resource.data.yearMonth);
      }

      match /month_locks/{yearMonth} {
        allow read: if isMember(messId);
        allow create, update, delete: if isAdmin(messId);
      }
    }

    // Join lookup by exact code only — no list (blocks code scraping).
    match /mess_codes/{code} {
      allow get: if signedIn() && code.size() == 6;
      allow list: if false;
      allow create: if signedIn() &&
        code.size() == 6 &&
        request.resource.data.messId is string &&
        messCreatedBy(request.resource.data.messId) == request.auth.uid;
      allow update: if signedIn() &&
        request.resource.data.messId == resource.data.messId;
      allow delete: if false;
    }

    function onlyPostCountersChanged() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['likeCount', 'commentCount']);
    }

    // ---- Community ----
    match /community_posts/{postId} {
      allow read: if signedIn();
      allow create: if signedIn() &&
        hasMess() &&
        request.resource.data.authorId == request.auth.uid &&
        request.resource.data.messId == myUser().messId;
      allow update: if signedIn() && (
        resource.data.authorId == request.auth.uid ||
        onlyPostCountersChanged()
      );
      allow delete: if signedIn() &&
        resource.data.authorId == request.auth.uid;

      match /likes/{uid} {
        allow read: if signedIn();
        allow create, delete: if signedIn() && request.auth.uid == uid;
      }

      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn() &&
          request.resource.data.authorId == request.auth.uid;
        allow update, delete: if signedIn() &&
          resource.data.authorId == request.auth.uid;
      }
    }

    match /follows/{followId} {
      allow read: if signedIn();
      allow create: if signedIn() &&
        request.resource.data.followerId == request.auth.uid &&
        request.resource.data.followingId is string &&
        request.resource.data.followerId != request.resource.data.followingId;
      allow delete: if signedIn() &&
        resource.data.followerId == request.auth.uid;
    }

    match /friend_requests/{requestId} {
      allow get: if signedIn() && (
        resource == null ||
        resource.data.fromUid == request.auth.uid ||
        resource.data.toUid == request.auth.uid
      );
      allow list: if signedIn() && (
        resource.data.fromUid == request.auth.uid ||
        resource.data.toUid == request.auth.uid
      );
      allow create: if signedIn() &&
        request.resource.data.fromUid == request.auth.uid &&
        request.resource.data.toUid is string &&
        request.resource.data.fromUid != request.resource.data.toUid &&
        request.resource.data.status == 'pending';
      allow update: if signedIn() &&
        resource.data.toUid == request.auth.uid &&
        resource.data.status == 'pending' &&
        (request.resource.data.status == 'accepted' ||
         request.resource.data.status == 'rejected');
      allow delete: if signedIn() && (
        resource.data.fromUid == request.auth.uid ||
        resource.data.toUid == request.auth.uid
      );
    }

    match /friendships/{friendshipId} {
      allow read: if signedIn();
      allow create: if signedIn() &&
        request.auth.uid in request.resource.data.uids &&
        request.resource.data.uids.size() == 2;
      allow delete: if signedIn() &&
        request.auth.uid in resource.data.uids;
    }

    match /conversations/{convId} {
      allow get: if signedIn() && (
        resource == null
          ? (convId.matches('^' + request.auth.uid + '_.+') ||
             convId.matches('.+_' + request.auth.uid + '$'))
          : request.auth.uid in resource.data.memberIds
      );
      allow list: if signedIn() &&
        request.auth.uid in resource.data.memberIds;
      allow create: if signedIn() &&
        request.auth.uid in request.resource.data.memberIds &&
        request.resource.data.memberIds.size() == 2 &&
        areFriends(
          request.resource.data.memberIds[0],
          request.resource.data.memberIds[1]
        );
      allow update: if signedIn() &&
        request.auth.uid in resource.data.memberIds &&
        request.resource.data.memberIds == resource.data.memberIds;

      match /messages/{messageId} {
        allow read: if signedIn() &&
          exists(/databases/$(database)/documents/conversations/$(convId)) &&
          request.auth.uid in
            get(/databases/$(database)/documents/conversations/$(convId)).data.memberIds;
        allow create: if signedIn() &&
          request.resource.data.senderId == request.auth.uid &&
          request.resource.data.text is string &&
          request.resource.data.text.size() > 0 &&
          exists(/databases/$(database)/documents/conversations/$(convId)) &&
          request.auth.uid in
            get(/databases/$(database)/documents/conversations/$(convId)).data.memberIds;
      }
    }
  }
}
